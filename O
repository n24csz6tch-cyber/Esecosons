-- ===== DUMP Punch Simulator (Venice) =====
-- Lista remotes y botones reales y los copia
local out = {}

for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
        table.insert(out, d.ClassName .. "  >>  " .. d:GetFullName())
    end
end
table.sort(out)

local pg = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
if pg then
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            table.insert(out, "BTN  >>  " .. d:GetFullName() .. "  ("..(d.Text or "")..")")
        end
    end
end

local text = table.concat(out, "\n")
print("===== DUMP VENICE =====\n" .. text)

if setclipboard then pcall(setclipboard, text) end

local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

local f = Instance.new("Frame")
f.Size = UDim2.new(0,330,0,430)
f.Position = UDim2.new(0.5,-165,0.5,-215)
f.BackgroundColor3 = Color3.fromRGB(12,12,16)
f.Parent = gui
Instance.new("UICorner", f).CornerRadius = UDim.new(0,10)

local sf = Instance.new("ScrollingFrame")
sf.Size = UDim2.new(1,-16,1,-90)
sf.Position = UDim2.new(0,8,0,44)
sf.BackgroundTransparency = 1
sf.ScrollBarThickness = 4
sf.CanvasSize = UDim2.new(0,0,0, #out*17+20)
sf.Parent = f

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.new(1,-8,0,#out*17+20)
lbl.BackgroundTransparency = 1
lbl.Text = text
lbl.TextColor3 = Color3.fromRGB(180,255,200)
lbl.Font = Enum.Font.Code
lbl.TextSize = 11
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextYAlignment = Enum.TextYAlignment.Top
lbl.Parent = sf

local h = Instance.new("TextLabel")
h.Size = UDim2.new(1,0,0,40)
h.BackgroundTransparency = 1
h.Text = "DUMP ("..#out.." items)"
h.TextColor3 = Color3.new(1,1,1)
h.Font = Enum.Font.GothamBold
h.TextSize = 14
h.Parent = f

local copy = Instance.new("TextButton")
copy.Size = UDim2.new(1,-16,0,36)
copy.Position = UDim2.new(0,8,1,-42)
copy.BackgroundColor3 = Color3.fromRGB(0,140,90)
copy.Text = "COPIAR TODO"
copy.TextColor3 = Color3.new(1,1,1)
copy.Font = Enum.Font.GothamBold
copy.Parent = f
copy.MouseButton1Click:Connect(function()
    if setclipboard then pcall(setclipboard, text) end
    copy.Text = "COPIADO! pegalo en el chat"
end)
