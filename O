-- Copiar todos los Remotes (Venice)
local list = {}
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
        table.insert(list, d:GetFullName())
    end
end
local txt = table.concat(list, "\n")

local gui = Instance.new("ScreenGui")
gui.Name = "VeniceCopy"; gui.ResetOnSpawn = false; gui.DisplayOrder = 999
gui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local f = Instance.new("Frame")
f.Size = UDim2.new(0,340,0,420); f.Position = UDim2.new(0.5,-170,0.5,-210)
f.BackgroundColor3 = Color3.fromRGB(12,12,16); f.BorderSizePixel = 0; f.Parent = gui
Instance.new("UICorner", f).CornerRadius = UDim.new(0,10)

local box = Instance.new("TextBox")
box.Size = UDim2.new(1,-16,1,-96); box.Position = UDim2.new(0,8,0,8)
box.BackgroundColor3 = Color3.fromRGB(20,20,26); box.TextColor3 = Color3.fromRGB(180,255,200)
box.Font = Enum.Font.Code; box.TextSize = 11; box.TextXAlignment = Enum.TextXAlignment.Left
box.TextYAlignment = Enum.TextYAlignment.Top; box.TextWrapped = true
box.ClearTextOnFocus = false; box.MultiLine = true
box.Text = txt; box.Parent = f
Instance.new("UICorner", box).CornerRadius = UDim.new(0,8)

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1,-16,0,40); btn.Position = UDim2.new(0,8,1,-52)
btn.BackgroundColor3 = Color3.fromRGB(40,150,90); btn.Text = "COPIAR TODO"
btn.TextColor3 = Color3.new(1,1,1); btn.Font = Enum.Font.GothamBold; btn.TextSize = 15
btn.Parent = f
Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)

btn.MouseButton1Click:Connect(function()
    local copiar = setclipboard or toclipboard or writeclipboard
    if copiar then copiar(txt) end
    btn.Text = "COPIADO ✓"
    task.delay(1.5, function() btn.Text = "COPIAR TODO" end)
end)
