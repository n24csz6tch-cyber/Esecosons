local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- juntar remotes
local remotes = {}
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
        remotes[#remotes+1] = d
    end
end
local function listaRemotes()
    local t = {}
    for i, r in ipairs(remotes) do t[i] = r:GetFullName() end
    return table.concat(t, "\n")
end

local function copiar(texto)
    local c = setclipboard or toclipboard or writeclipboard
    if c then c(texto) end
end

