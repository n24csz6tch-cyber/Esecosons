local lines = {}
local showRecv = false
local function refrescar()
    local vis = {}
    for _, s in ipairs(lines) do
        if showRecv or s:sub(1,4) == "FIRE" or s:sub(1,2) == "!!" then
            table.insert(vis, s)
        end
    end
    lbl.Text = table.concat(vis, "\n")
    sf.CanvasPosition = Vector2.new(0, 1e9)
end
local function log(s)
    table.insert(lines, s)
    if #lines > 120 then table.remove(lines, 1) end
    refrescar(); print("[SPY] "..s)
end

local function fmt(...)
    local n = select("#", ...); local t = {}
    for i = 1, n do
        local v = select(i, ...); local ty = typeof(v)
        if ty == "string" then t[i] = '"'..v..'"'
        elseif ty == "number" or ty == "boolean" then t[i] = tostring(v)
        else t[i] = "<"..ty..">" end
    end
    return table.concat(t, ", ")
end

-- botones
local function boton(txt, col, w, x, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(w,0,0,32); b.Position = UDim2.new(x,y,1,0)
    b.BackgroundColor3 = col; b.Text = txt; b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold; b.TextSize = 12; b.Parent = f
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
    return b
end
