local lines = {}
local function log(s)
    table.insert(lines, s)
    if #lines > 80 then table.remove(lines, 1) end
    lbl.Text = table.concat(lines, "\n")
    sf.CanvasPosition = Vector2.new(0, 1e9)
    print("[SPY] "..s)
end

local function fmt(...)
    local n = select("#", ...); local t = {}
    for i = 1, n do
        local v = select(i, ...); local ty = typeof(v)
        if ty == "string" then t[i] = '"'..v..'"'
        elseif ty == "number" or ty == "boolean" then t[i] = tostring(v)
        else t[i] = "<"..ty..">" end
    end
    return table.concat(t, ", ")
end

-- Servidor -> Cliente
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") then
        d.OnClientEvent:Connect(function(...)
            log("RECV "..d.Name.."  ("..fmt(...)..")")
        end)
    end
end

-- Cliente -> Servidor (hook)
pcall(function()
    local oldFire
    oldFire = hookfunction(Instance.new("RemoteEvent").FireServer, newcclosure(function(self, ...)
        log("FIRE "..self.Name.."  ("..fmt(...)..")")
        return oldFire(self, ...)
    end))
end)

